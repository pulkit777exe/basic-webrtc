    "typecheck": "bunx tsc --noEmit",
    "signaling": "bun run signaling-server.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
