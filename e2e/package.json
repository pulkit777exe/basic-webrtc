{
  "name": "basic-webrtc-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-browser WebRTC rig: two Chromium peers running the production peer module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
