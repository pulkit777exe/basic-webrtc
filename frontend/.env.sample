VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com/ws
VITE_DEEPGRAM_LIVE_CAPTIONS=true

# NOTE: VITE_* values bake in at build time. On Vercel, set them in the
# dashboard (Project → Settings → Environment Variables) and redeploy after
# any change. A production build without VITE_API_URL fails fast.
# Optional: abort hanging API calls (default 15000 ms)
# VITE_API_TIMEOUT_MS=15000