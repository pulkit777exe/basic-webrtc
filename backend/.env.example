# Backend Environment Variables
#
# FREE-TIER QUICKSTART (Render + Neon + Upstash, all free):
#   DATABASE_URL  → free Postgres from Neon or Supabase
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN → free Upstash Redis
#   JWT_SECRET / JWT_REFRESH_SECRET → any long random strings
#   ALLOWED_ORIGINS → your Vercel frontend URL, e.g. https://your-app.vercel.app
# See docs/FREE_TIER_DEPLOY.md for the full guide.
# NOTE: REDIS_URL (TCP Redis for BullMQ) is OPTIONAL — leave it unset on the
# free tier; export/deletion jobs run in-process instead.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-random-64-char-string
JWT_REFRESH_SECRET=replace-with-random-64-char-string
# Optional but recommended: keeps room JWTs (WS upgrade + captions upload)
# under a different key than session tokens. Falls back to JWT_SECRET if unset.
# JWT_ROOM_SECRET=replace-with-random-64-char-string

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/oauth/google/callback

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Required for registration OTP, password resets, 2FA codes and security
# alerts. Free tier: 3,000 emails/month. Create the key in Resend →
# Settings → API Keys. Keep the REAL key out of this file: backend/.env is
# gitignored; production uses Render env vars. Setup details (incl. domain
# verification): docs/FREE_TIER_DEPLOY.md § Email (Resend).
RESEND_API_KEY=your-resend-api-key
# Sender identity. Dev: "Meet <onboarding@resend.dev>" (Resend delivers that
# sender only to your own account address). Production: verified domain.
EMAIL_FROM="Meet <onboarding@resend.dev>"

# ─── Room Settings ──────────────────────────────────────────────────────────
MAX_PARTICIPANTS=10
OTP_EXPIRY_MINUTES=15

# ─── Deepgram (Live Captions) ───────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key
CAPTION_TRANSCRIBE_PROVIDER=deepgram
DEEPGRAM_LIVE_MODEL=nova-3
DEEPGRAM_LIVE_LANGUAGE=en

# ─── Upstash Redis (required; free tier) ────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
REDIS_PASSWORD=replace-with-redis-password

# ─── BullMQ / background jobs (OPTIONAL — scale-up only) ────────────────────
# TCP Redis URL for BullMQ delayed/queued jobs. Leave UNSET on Render's free
# tier: exports run in-process and deletions use a DB-backed poller instead.
# REDIS_URL="redis://:password@host:6379"

# ─── WebRTC ICE/TURN ────────────────────────────────────────────────────────
# Public Google STUN is the default. For reliable calls behind symmetric NATs,
# add your own TURN relay — a hosted TURN provider's free tier, or
# self-hosted coturn (docs/FREE_TIER_DEPLOY.md § TURN).
# STUN_SERVERS="stun:stun.l.google.com:19302"
# TURN_SERVERS="turn:turn.yourdomain.com:3478"
# TURN_SECRET="your-turn-shared-secret"
# TURN_TTL_SEC=300
ICE_CANDIDATE_POOL_SIZE=10
ICE_BUNDLE_POLICY=balanced
ICE_RTCP_MUX_POLICY=require
TRUST_PROXY=1

# ─── WebSocket ──────────────────────────────────────────────────────────────
WS_MAX_MESSAGE_BYTES=524288
